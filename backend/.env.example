# =============================================================================
# backend/.env.example
# =============================================================================
# Copy this file to backend/.env.dev for local development:
#   cp backend/.env.example backend/.env.dev
#
# Fill in the values marked REQUIRED. Anything marked OPTIONAL can be left
# blank for local dev; the corresponding feature simply will not run.
#
# NEVER commit a populated .env file. Real values come from Ali or from the
# production VPS at /opt/colaberry-accelerator/.env.
# =============================================================================


# ----- App basics ------------------------------------------------------------
APP_ENV=dev                              # dev | staging | production
PORT=3001
NODE_OPTIONS=--max-old-space-size=512
TZ=America/Chicago


# ----- Database --------------------------------------------------------------
# Local docker-compose defaults; override if you point at a remote DB.
DATABASE_URL=postgres://accelerator:accelerator@accelerator-db:5432/accelerator_prod
PROD_DB_USER=accelerator
PROD_DB_NAME=accelerator_prod
REDIS_URL=redis://accelerator-redis:6379


# ----- URLs ------------------------------------------------------------------
APP_BASE_URL=http://localhost:8888
FRONTEND_URL=http://localhost:8888
BASE_URL=http://localhost:3001
PORTAL_BASE_URL=http://localhost:8888


# ----- Anthropic / OpenAI (REQUIRED for any LLM features) --------------------
OPENAI_API_KEY=
AI_MODEL=gpt-4o
AI_MAX_TOKENS=2000
CHAT_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=1200
CB_HANDLER_MODEL=gpt-4o
CONTEXTUAL_SUGGESTION_MODEL=gpt-4o-mini


# ----- Basecamp (REQUIRED for any BC integration) ----------------------------
# Token rotates every 2 weeks. Pull current value from CCPP Basecamp_AuthInfo
# table on prod, or ask Ali.
BASECAMP_ACCESS_TOKEN=
BASECAMP_ACCOUNT_ID=3945211
BASECAMP_USER_AGENT=Colaberry
ALI_BC_USER_ID=17454835


# ----- Gmail OAuth (REQUIRED for inbox + email sending features) -------------
# Shared org credentials. Ask Ali for the values.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_COLABERRY_ADDRESS=ali@colaberry.com
# VIP + Inbox COS alert destination. Do NOT point this at alimuwwakkil@gmail.com:
# that mailbox is on the do-not-send list (backend/src/scripts/lib/suppressedRecipients.js).
VIP_ALERT_TO=ali@colaberry.com

# Inbox COS — personal Gmail mailbox (alimuwwakkil@gmail.com). Falls back to the
# GMAIL_CLIENT_ID/SECRET above if unset. Re-authorize with scripts/inbox-auth-helper.js.
GMAIL_PERSONAL_CLIENT_ID=
GMAIL_PERSONAL_CLIENT_SECRET=
GMAIL_PERSONAL_REFRESH_TOKEN=

# Inbox COS — Hotmail mailbox (ali_muwwakkil@hotmail.com) via Microsoft Graph.
# MS_GRAPH_* is the runtime credential graphMailService.ts reads. MS_OAUTH_* is only
# used by scripts/inbox-auth-helper.js when minting a new MS_GRAPH_REFRESH_TOKEN.
MS_GRAPH_CLIENT_ID=
MS_GRAPH_REFRESH_TOKEN=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=


# ----- Google Calendar (service account, domain-wide delegation) -------------
# Used by calendar booking + the Family Command Center daily briefing (V2).
# The service account impersonates GOOGLE_CALENDAR_OWNER_EMAIL.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_OWNER_EMAIL=ali@colaberry.com
GOOGLE_CALENDAR_ID=
# Family Command Center V2: calendarId of the "Family" calendar read for the
# daily briefing. Discover it with: node backend/src/scripts/discoverFamilyCalendar.js
# Must be shared with ali@colaberry.com (the impersonated owner) to be readable.
GOOGLE_FAMILY_CALENDAR_ID=


# ----- Zoom (Server-to-Server OAuth app, class video + cloud recording) ------
# Replaces Google Meet as the class meeting/recording provider. Create the app
# at marketplace.zoom.us -> Develop -> Build App -> Server-to-Server OAuth,
# under the Zoom account that has Cloud Recording enabled. Also add an Event
# Subscription for `recording.completed` pointing at
# https://enterprise.colaberry.ai/api/webhook/zoom -- ZOOM_WEBHOOK_SECRET_TOKEN
# comes from that same Feature page (NOT the Client Secret below).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
# The Zoom user every class meeting is created under (the host account with
# Cloud Recording + account-level auto-recording enabled).
ZOOM_HOST_EMAIL=


# ----- Mandrill (transactional email) ----------------------------------------
SMTP_HOST=smtp.mandrillapp.com
SMTP_PORT=587
SMTP_USER=ali@colaberry.com
SMTP_PASS=
EMAIL_FROM="Colaberry <ali@colaberry.com>"


# ----- GitHub (OPTIONAL, used by repo-watcher + integrations) ----------------
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_REPO=ColaberryIntern/ColaberryEnterprise_AI_LeadershipAccelerator

# ----- GitHub student OAuth + webhook (REQUIRED for per-student GitHub connect) -
# Register an OAuth App at github.com/settings/developers. Callback URL must
# exactly match GITHUB_OAUTH_REDIRECT_URI. Webhook secret is a value you choose
# (any random string) and must match what's configured on the repo webhook.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://enterprise.colaberry.ai/api/portal/github/oauth/callback
GITHUB_WEBHOOK_URL=https://enterprise.colaberry.ai/api/webhook/github
GITHUB_WEBHOOK_SECRET=


# ----- Synthflow voice agent (OPTIONAL) --------------------------------------
SYNTHFLOW_API_KEY=
SYNTHFLOW_WELCOME_AGENT_ID=
SYNTHFLOW_INTEREST_AGENT_ID=
# Agent that dials inbound "call me now" callbacks from training.colaberry.com.
# Set to the Cora Outbound Admissions module id (e.g. 1b432b69-fcb1-4b70-9130-8a66e45eaff5).
# Its Synthflow-attached knowledge base is used automatically — never passed via the API.
# If left blank, POST /api/v1/request-callback falls back to SYNTHFLOW_INTEREST_AGENT_ID.
SYNTHFLOW_CALLBACK_AGENT_ID=
# AI Flotation's own callback agent. Unset means the voice path SKIPS for that brand;
# it deliberately does not fall back to a Colaberry agent.
SYNTHFLOW_AI_FLOTATION_AGENT_ID=



# ----- Apollo / Outreach (OPTIONAL) ------------------------------------------
APOLLO_API_KEY=
# Master kill switch for ALL Apollo API calls (search / enrich / phone-reveal).
# Every call burns paid credits, so Apollo is OFF unless this is exactly "true".
# Leave unset/false to fully stop the scheduled lead-gen agents from spending credits.
APOLLO_ENABLED=false


# ----- Paysimple (OPTIONAL, payments) ----------------------------------------
PAYSIMPLE_API_USER=
PAYSIMPLE_API_KEY=
PAYSIMPLE_ENV=sandbox
PAYSIMPLE_WEBHOOK_SECRET=
PAYMENT_MODE=test
# Scheduled reconcile of our recorded PaySimple payments (settled -> revenue,
# failed/reversed -> subtracted). Needs live READ creds above + PAYSIMPLE_ENV=live.
# OFF by default (ships dark).
PAYSIMPLE_SYNC_ENABLED=false


# ----- Social posting (OPTIONAL) ---------------------------------------------
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=
DEVTO_API_KEY=
PRODUCTHUNT_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
DISCOURSE_USERNAME=
DISCOURSE_API_KEY=


# ----- Skool (OPTIONAL) ------------------------------------------------------
SKOOL_COMMUNITY_URL=
SKOOL_EMAIL=
SKOOL_PASSWORD=
SKOOL_DAILY_LIMIT=10
SKOOL_ENABLED=false


# ----- Inbox COS phone-accessible SMS / Hotmail ------------------------------
INBOX_COS_SMS_TO=6825975784@tmomail.net
INBOX_COS_ALERT_GMAIL=ali@colaberry.com
ADMIN_ALERT_PHONE=
# Master switch for ALL inbox COS alerts (VIP, urgent, ask-user digest, daily
# summary, meeting prep, missed-opportunities report). OFF unless set to "true".
INBOX_COS_ALERTS_ENABLED=false


# ----- Feature flags (defaults for dev) --------------------------------------
ENABLE_CHAT=true
ENABLE_EXECUTION_ENGINE=true
ENABLE_CONTEXT_GRAPH_V2=true
ENABLE_EXPERIMENTAL_FEATURES=true
ENABLE_ARTIFACT_COMPILER=true
ENABLE_ARTIFACT_GRAPH=true
# AI Project Factory (Phase 2 LLM decomposition). Ships DARK — leave false until ready to pilot.
ENABLE_FACTORY_GENERATION=false
ENABLE_FOLLOWUP_SCHEDULER=false
ENABLE_AUTO_EMAIL=false
ENABLE_VOICE_CALLS=false
ENABLE_VOICE_CALL_FOR_OVERVIEW=false
ENABLE_VISITOR_TRACKING=false
ENABLE_HIGH_INTENT_ALERT=false
ENABLE_REQUIREMENTS_MATCHING=true
AUTONOMOUS_AUTOAPPLY=false
# Student Today screen: redesigned command band + mobile bottom-nav + QR handoff.
# Default ON. Set to "false" and restart the backend for an instant rollback to
# the classic Today top (no image rebuild / frontend redeploy needed).
PORTAL_TODAY_REDESIGN_ENABLED=true
# CAPE Phase 5: the finite "Today Plan" section above the infinite Explore
# feed, card-treatment chips (Why this/Level/Proof), learner feedback controls,
# and the skill-detail drawer. Default OFF everywhere including production —
# flag-off keeps the Today page byte-identical to pre-Phase-5 behavior.
CAPE_TODAY_PLAN_ENABLED=false
# Award engagement points (the top-right HUD total) when a student completes a
# curriculum item (survey / knowledge check / card / lesson). Default ON; set to
# false to dark-disable coursework awards (streak + RSVP awards are unaffected).
PORTAL_POINTS_AWARD_ENABLED=true
# Paid gate on the build/evidence routes (/api/portal/project*): free Explorers get
# HTTP 402; paid/comped/staff/sponsor-seat enrollments pass. Default OFF (ships dark).
BUILD_PAID_GATE_ENABLED=false
# Page-level content paywall: blocks whole pages (Classroom, Projects, Cert Prep)
# behind a preview+upsell screen for anyone without full curriculum access. Separate
# from BUILD_PAID_GATE_ENABLED above (different blast radius). Default OFF (ships dark).
CONTENT_PAGE_GATE_ENABLED=false
# Week-start gating — TODAY TIMELINE ONLY (does not affect Classroom): a
# curriculum week's cards stay off the Today feed (except that week's own first/
# entry card) until the student completes >=1 completable card in that week.
# Default OFF (ships dark, byte-identical to legacy "everything visible").
TIMELINE_WEEK_START_GATE_ENABLED=false
# Community level reconcile: fold the legacy community level tiers (0/1500/2700/4200)
# onto the ONE canonical points ladder (0/150/400/900). Default OFF (byte-identical to
# legacy); ON makes communityService.levelFor defer to pointsService.levelForPoints.
COMMUNITY_LEVEL_USE_CANONICAL=false
# Anti-cheat daily point caps: clamp low-value ambient-feed completions (100/day) and
# community post/comment/like awards (75/day) so neither category can be farmed for
# unbounded points in one Central day. Default OFF (byte-identical to today; no clamping).
POINTS_DAILY_CAPS_ENABLED=false
# Community post-quality gate: a post's +5 creation reward is withheld until a PEER
# likes it (released on the first peer like, keyed idempotently to the post; a self-like
# never triggers it). Blocks spam-posting for points. Default OFF (posts reward +5 on
# creation exactly as today).
COMMUNITY_POST_QUALITY_GATE_ENABLED=false
# Five-band UI re-skin: the portal shows the canonical 5-band ladder (AI Aware →
# AI Enabled → AI Builder → AI Architect) as the primary level identity, and free
# accounts at the AI Enabled ceiling see a "Become an AI Builder" upgrade card. The
# flag rides the GET /api/portal/points response so the SPA flips at runtime (no
# rebuild). Default OFF: flag-off is the legacy "Level N · Apprentice/…/Principal" HUD.
FIVE_BAND_UI_ENABLED=false
# Role-aware "People" right-rail panel. Staff/admin see cross-cohort presence (online
# now) + a classes list + a sponsors/businesses list; students see their class first,
# then recently-active people OUTSIDE their cohort (useful for cohortless users). Default
# OFF: GET /api/portal/people/panel returns { enabled:false } and the rail keeps its
# cohort-scoped presence behavior byte-identical (ships dark).
PEOPLE_PANEL_ROLES_ENABLED=false

# ----- AI News Flash intelligence pipeline -----------------------------------
# The daily generator behind the intelligence-pipeline curriculum feed
# (ai_news_flash). RSS collect + dedup is always cheap; card materialization runs
# an LLM (gpt-4o-mini) and is the only cost-bearing step, gated below. Default OFF.
AI_NEWS_INGEST_ENABLED=false
# Cards materialized per run — the daily 03:15 CT cron AND each boot catch-up
# (~1 gpt-4o-mini call per card, pennies/day). Bump for a livelier feed; a 30-day
# rolling prune keeps the window bounded (~MAX_PER_RUN x 30 cards). Default 3.
AI_NEWS_MAX_PER_RUN=3
# Boot catch-up staleness window (hours). On boot, if the newest ai_news_flash
# card is older than this and items are pending, materialize a catch-up run so a
# redeploy through the cron window doesn't drop a day. Default 20 (< the 24h cron).
AI_NEWS_CATCHUP_STALE_HOURS=20
# Optional feed overrides: "Source|https://url, Source2|https://url2". Unset uses
# the built-in AI-lab RSS list (OpenAI, Hugging Face, Google DeepMind, NVIDIA).
# AI_NEWS_FEEDS=

# ----- Intelligence pipeline generators (the 9 beyond AI News Flash) ----------
# Each generator shares the generic intel framework: collect from its source →
# dedup → score → LLM-summarize into a card. Cost-bearing materialization is gated
# per-generator by its own *_INGEST_ENABLED flag (default OFF → ships dark; the
# cheap library ingest still runs). *_MAX_PER_RUN bounds cards/day (default 1). The
# daily cron is 03:45 CT; a 30-day prune keeps each generator's window bounded.
# Flip a flag to ON to light up that generator. gpt-4o-mini → pennies/day each.
AI_RESEARCH_DIGEST_INGEST_ENABLED=false
AI_RESEARCH_DIGEST_MAX_PER_RUN=1
AI_ARCHITECTURE_BREAKDOWN_INGEST_ENABLED=false
AI_ARCHITECTURE_BREAKDOWN_MAX_PER_RUN=1
BUILD_BREAKDOWN_INGEST_ENABLED=false
BUILD_BREAKDOWN_MAX_PER_RUN=1
AI_TOOL_OF_THE_DAY_INGEST_ENABLED=false
AI_TOOL_OF_THE_DAY_MAX_PER_RUN=1
AI_QUOTE_OF_THE_DAY_INGEST_ENABLED=false
AI_QUOTE_OF_THE_DAY_MAX_PER_RUN=1
CLAUDE_CODE_TECHNIQUE_INGEST_ENABLED=false
CLAUDE_CODE_TECHNIQUE_MAX_PER_RUN=1
MCP_SERVER_SPOTLIGHT_INGEST_ENABLED=false
MCP_SERVER_SPOTLIGHT_MAX_PER_RUN=1
AI_VIDEO_STREAM_INGEST_ENABLED=false
AI_VIDEO_STREAM_MAX_PER_RUN=1
MARKET_INTELLIGENCE_INGEST_ENABLED=false
MARKET_INTELLIGENCE_MAX_PER_RUN=1
# Extra sources needed for two generators to actually fetch (they no-op without):
# AI Video Stream needs a YouTube Data API key; Market Intelligence needs the
# Opportunity Pulse REST base URL (+ optional bearer token).
# YOUTUBE_API_KEY=
# AI_VIDEO_STREAM_QUERY=AI systems architecture
# OPPORTUNITY_PULSE_URL=
# OPPORTUNITY_PULSE_TOKEN=
# Factory gov-opportunities feed (AdminGovOpportunitiesPage). A scoped read-only key OP mints for the
# accelerator (op_<64 hex>), sent as X-API-Key to the digest-parity best-fit endpoint. Unset => the page
# shows the labeled in-app snapshot (degrade-dark). Not an admin account; writes stay 401.
# OPPORTUNITY_PULSE_API_KEY=
# OPPORTUNITY_PULSE_BASE=https://op.colaberry.ai
# Default limit is 50 — best-fit caps at ~50, so this surfaces the whole curated good set (not just the top 10).
# OPPORTUNITY_PULSE_LIST_PATH=/api/v1/bonfire/best-fit?limit=50
#
# Gov qualification v2 detail/list adapter (Phase 2). SEPARATE from the v1 best-fit credential above: v2 uses
# its OWN dedicated key with scope read:gov_opportunities, sent as X-API-Key. v2 NEVER falls back to the v1 key
# — if OPPORTUNITY_PULSE_V2_API_KEY is unset, v2 is treated as not-configured (in production it then fails
# closed and pursuit approval is blocked). Base is scheme+host, no trailing slash/path; path defaults to
# /api/v2/gov-opportunities (override only if OP mounts elsewhere).
# OPPORTUNITY_PULSE_V2_BASE=https://op.colaberry.ai
# OPPORTUNITY_PULSE_V2_API_KEY=
# OPPORTUNITY_PULSE_V2_PATH=/api/v2/gov-opportunities


# ----- Ops engine knobs ------------------------------------------------------
OPS_CB_DORMANT_DAYS=30
OPS_STALE_HIDE_DAYS=90


# ----- VA ERP Integration (OPTIONAL — required only for VA ERP agent) --------
# OAuth 2.0 client credentials endpoint for the VA legacy ERP system
VA_ERP_TOKEN_URL=
VA_ERP_CLIENT_ID=
VA_ERP_CLIENT_SECRET=
# JSON array of modules: [{"name":"IFCAP","baseUrl":"https://...","endpoints":["/vendors"]}]
VA_ERP_MODULE_CONFIG=[]
VA_ERP_REQUEST_TIMEOUT_MS=15000
VA_ERP_MAX_RETRIES=3


# ----- Preview stacks (OPTIONAL, per-user preview environments) --------------
PREVIEW_STACKS_ROOT=/var/preview-stacks
PREVIEW_PORT_POOL_START=11000
PREVIEW_PORT_POOL_END=11999
PREVIEW_IDLE_TIMEOUT_MS=1800000
PREVIEW_CPU_LIMIT=0.5
PREVIEW_MEM_LIMIT=512m
PREVIEW_PROXY_HOST=host.docker.internal
PREVIEW_BOOT_WAIT_MS=15000


# ----- Enterprise CRM integration (training.colaberry.com → /api/v1/leads) ---
# Static service token. Generate once with: openssl rand -hex 32
# Ali sets this in the production container env AND hands the same value to
# Sai as ENTERPRISE_CRM_TOKEN on the Cloud Run side.
ENTERPRISE_CRM_TOKEN=

# ----- Branded welcome email (Open House / Explorer signups) -----------------
# createExplorerEnrollment sends a branded welcome with a one-click portal magic
# link on every new Explorer signup (POST /api/v1/open-house/register).
# From-address MUST be a Mandrill-verified domain. colaberry.com is verified;
# training.colaberry.com is NOT (yet). Keep training@colaberry.com until that
# domain's SPF/DKIM is added to Mandrill, then swap to @training.colaberry.com.
TRAINING_WELCOME_FROM_EMAIL=training@colaberry.com
TRAINING_WELCOME_FROM_NAME=Colaberry Training
# Portal magic-link lifetime for the welcome email (days).
TRAINING_WELCOME_TOKEN_TTL_DAYS=30


# ----- Portal / curriculum access --------------------------------------------
# Free-trial gate. When ON (the default), Explorer (unenrolled free-trial) accounts
# see ONLY the Week 0 "Free Preview" in the Classroom; paid members see all 12 weeks.
# Set to 'false' to open the whole curriculum to free signups (e.g. a launch promo).
# Any value other than 'false' keeps the gate ON.
EXPLORER_WEEK0_ONLY=true

# ----- Misc ------------------------------------------------------------------
UPLOAD_DIR=/var/uploads
DRY_RUN=false
VERBOSE=false
SYSTEM_MODE=normal


# =============================================================================
# DO NOT COMMIT THIS FILE WITH REAL VALUES.
# .env.dev is already in .gitignore. Verify with: git check-ignore backend/.env.dev
# =============================================================================

# Curriculum video link health check (daily 6:20 AM CT).
# OFF by default: enabling it starts real alert notifications.
# Run once with { dryRun: true } before turning on.
#
# Requires YOUTUBE_API_KEY (already set in production, shared with the composer
# and openclaw services). The check reads video health from the YouTube Data API
# v3 rather than by scraping, because the production host is served a bot
# challenge on the watch page and a scraping run there sees nothing at all.
# Cost is ~5 quota units/day out of the default 10,000: videos.list is 1 unit per
# call and takes 50 ids at a time. Without the key the check refuses to run and
# logs error_class=NotConfigured, rather than reporting a clean corpus.
CURRICULUM_VIDEO_HEALTH_ENABLED=false

# ── Growth Journey OS ────────────────────────────────────────────────────────
# Every one of these is OFF unless the value is the exact string "true".
# The master gates all five capabilities: with it off, each capability is off
# regardless of its own value. Phases 1 and 2 shipped the first four flags and
# documented none of them; T303 added journeyDecisions and this block.
GROWTH_JOURNEY_ENABLED=false
# Write generic journey signals for non-Explorer subjects. Safe to enable first.
GROWTH_JOURNEY_SIGNAL_INGEST_ENABLED=false
# Source/brand/intent/path classification. Reads and records; acts on nothing.
GROWTH_JOURNEY_CLASSIFICATION_ENABLED=false
# Governed SHADOW decisions: score, generate candidates, arbitrate, record one
# row with every suppressed candidate and its reason. Contacts nobody.
GROWTH_JOURNEY_DECISIONS_ENABLED=false
# Human handoffs (Phase 4): a deferred decision becomes a ranked, evidence-
# complete growth_journey_handoffs row and, where a policy names an assignee,
# a tickets row a human reads. A row in a queue - never a notification, never
# a contact. Off, the deferral stays on the decision row.
GROWTH_JOURNEY_HANDOFFS_ENABLED=false
# THE ONLY FLAG THAT CAN CAUSE A PERSON TO BE CONTACTED. Ali only.
GROWTH_JOURNEY_EXECUTION_ENABLED=false

# ── Social publishing (Marketing Ops OS) ─────────────────────────────────────────────────
# Which providers publish DIRECTLY to the network from this process, comma-separated. Unset or
# empty = every provider hands off to a person. Only providers with an implemented adapter are
# honoured (linkedin_member, linkedin_organization); anything else is logged and ignored.
# LIVE_CONNECTORS=linkedin_member
# LinkedIn app credentials (developer portal -> your app -> Auth). Read at call time: add them
# and restart the backend. The redirect URI must match the app's authorised redirect exactly.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://www.refactored.ai/api/marketing/linkedin/callback
# Where uploaded media lives inside the container (the `uploads` volume). Default shown.
# MEDIA_ROOT=/app/uploads/media
